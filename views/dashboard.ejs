<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light d-flex flex-column min-vh-100">
    <%- include("partials/navbar.ejs") %>
        <% if(success) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
            <% } %>

                <div class="container mt-3 mb-5">
                    <h2>Welcome, <%= user.username %>!</h2>

                    <div class="row g-2 g-md-3 mt-3 mb-4">
                        <div class="col-12 col-lg-4">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6>Total Applications</h6>
                                    <h3 class="text-muted">
                                        <%= totalApplications %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6>Applied</h6>
                                    <h3 class="text-muted">
                                        <%= appliedCount %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6>Interviews</h6>
                                    <h3 class="text-muted">
                                        <%= interviewCount %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6>Rejected</h6>
                                    <h3 class="text-muted">
                                        <%= rejectedCount %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-2">
                            <div class="card shadow-sm h-100">
                                <div class="card-body">
                                    <h6>Offers</h6>
                                    <h3 class="text-muted">
                                        <%= offerCount %>
                                    </h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card shadow-sm p-3 mb-4">
                        <h5 class="mb-3">Application Status Overview</h5>
                        <div style="max-width: 400px; margin: auto;">
                            <% if (totalApplications> 0) { %>

                                <canvas id="applicationChart"></canvas>

                                <% } else { %>

                                    <div class="text-center py-4">
                                        <h6>No applications yet!</h6>
                                        <p class="text-muted">
                                            Add your first job application to see your chart.
                                        </p>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4>Your Applications</h4>
                            <a href="/jobs/new" class="btn btn-primary">+ <span class="d-none d-sm-inline">Add
                                    Application</span></a>
                        </div>
                        <form action="/dashboard" method="GET" class="mb-4">
                            <div class="row g-2 align-items-center">
                                <div class="col-12 col-md">
                                    <input type="text" class="form-control" name="search"
                                        placeholder="Search company or position..." value="<%= search || '' %>">
                                </div>
                                <div class="col-12 col-md-auto">
                                    <select name="status" class="form-select">
                                        <option value="all" <%=filter==="all" ? "selected" : "" %> >All Applications
                                        </option>
                                        <option value="Applied" <%=filter==="Applied" ? "selected" : "" %> >Applied
                                        </option>
                                        <option value="Interview" <%=filter==="Interview" ? "selected" : "" %>
                                            >Interview</option>
                                        <option value="Rejected" <%=filter==="Rejected" ? "selected" : "" %> >Rejected
                                        </option>
                                        <option value="Offer" <%=filter==="Offer" ? "selected" : "" %> >Offer</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-auto">
                                    <select name="sortBy" class="form-select">
                                        <option value="newest" <%=sortBy==="newest" ? "selected" : "" %> >Newest First
                                        </option>
                                        <option value="oldest" <%=sortBy==="oldest" ? "selected" : "" %> >Oldest First
                                        </option>
                                        <option value="company" <%=sortBy==="company" ? "selected" : "" %> </option>
                                        Company Name (A-Z)</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-auto">
                                    <button type="submit" class="btn btn-primary">Search</button>
                                    <a href="/dashboard" class="btn btn-outline-secondary">
                                        Clear Filters
                                    </a>
                                </div>
                            </div>
                        </form>
                        <% if(jobs.length===0) { %>
                            <p class="text-muted">No applications yet. Track your first job application!</p>
                            <% } else { %>
                                <div class="row">
                                    <% jobs.forEach(job=> { %>
                                        <div class="col-sm-6 mb-3">
                                            <div class="card mb-3 shadow-sm h-100">
                                                <div class="card-body">
                                                    <h5>
                                                        <%= job.company %>
                                                    </h5>
                                                    <p>
                                                        <%= job.position %>
                                                    </p>
                                                    <p>Status: <%= job.status %>
                                                    </p>
                                                    <p>Job Type: <%= job.jobType %>
                                                    </p>

                                                    <a href="/jobs/<%= job._id %>/edit"
                                                        class="btn btn-outline-primary mb-2">Edit</a>

                                                    <form action="/jobs/<%= job._id %>?_method=DELETE" method="POST"
                                                        onsubmit="return confirm('Are you sure you want to delete this job Application?');">
                                                        <button type="submit"
                                                            class="btn btn-outline-danger">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                </div>
                                <% } %>
                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">

                        <% if(page> 1) { %>
                            <a href="/dashboard?page=<%= page - 1 %>&search=<%= search || '' %>&status=<%= filter %>&sortBy=<%= sortBy %>"
                                class="btn btn-outline-primary">
                                Previous
                            </a>
                            <% } %>

                                <span class="btn btn-light">
                                    Page <%= page %> of <%= totalPages %>
                                </span>

                                <% if(page < totalPages) { %>
                                    <a href="/dashboard?page=<%= page + 1 %>&search=<%= search || '' %>&status=<%= filter %>&sortBy=<%= sortBy %>"
                                        class="btn btn-outline-primary">
                                        Next
                                    </a>
                                    <% } %>

                    </div>
                </div>
                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                <script>
                    const appliedCount = <%- JSON.stringify(appliedCount) %>;
                    const interviewCount = <%- JSON.stringify(interviewCount) %>;
                    const rejectedCount = <%- JSON.stringify(rejectedCount) %>;
                    const offerCount = <%- JSON.stringify(offerCount) %>;

                    const ctx = document.getElementById("applicationChart");

                    if (ctx) {
                        new Chart(ctx, {
                            type: "doughnut",

                            data: {
                                labels: ["Applied", "Interview", "Rejected", "Offer"],

                                datasets: [{
                                    data: [
                                        appliedCount,
                                        interviewCount,
                                        rejectedCount,
                                        offerCount
                                    ],

                                    backgroundColor: [
                                        "#3B82F6",
                                        "#F59E0B",
                                        "#EF4444",
                                        "#10B981"
                                    ],

                                    borderWidth: 0
                                }]
                            }
                        });
                    }

                </script>
                <%- include("partials/footer.ejs") %>
</body>

</html>