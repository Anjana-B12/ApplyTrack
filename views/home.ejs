<!DOCTYPE html>
<html lang="en" data-bs-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ApplyTrack</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include("partials/navbar.ejs") %>
    <!-- hero section -->
    <section class="py-5">
        <div class="container text-center py-5">
            <h1 class="display-4 fw-bold">Your Job Search, Organized in one place.</h1>
            <p class="lead text-secondary mt-3">Track your job applications, manage interviews, and stay on top of your
                career journey.</p>
            <div class="mt-4">
                <a href="/register" class="btn btn-primary btn-lg">Start Tracking</a>
            </div>
        </div>
    </section>

    <!-- feature section -->
    <section class="bg-light py-5">
        <div class="container">
            <h2 class="text-center fw-bold mb-5">Everything you need to stay organized</h2>
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="card-title">Track Your Applications</h5>
                            <p class="text-secondary">Keep all your job applications organized in one place.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="card-title">Monitor Progress</h5>
                            <p class="text-secondary">Track whether your applications are applied, interviewing or offered.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h5 class="card-title">Stay Organized</h5>
                            <p class="text-secondary">Keep important job details and interview notes together.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- how it works -->
    <section class="py-5 mb-5">
        <div class="container text-center">
            <h2 class="fw-bold mb-5">How it Works</h2>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="text-primary fw-bold h4 mb-2">1</div>
                    <h5>Create an Account</h5>
                    <p class="text-secondary">Sign up and get started.
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="text-primary fw-bold h4 mb-2">2</div>
                    <h5>Add Applications</h5>
                    <p class="text-secondary">Record the jobs you apply for.
                    </p>
                </div>
                <div class="col-md-4">
                    <div class="text-primary fw-bold h4 mb-2">3</div>
                    <h5>Track Progress</h5>
                    <p class="text-secondary">Monitor your applications and interviews.
                    </p>
                </div>
            </div>
        </div>
    </section>
    <%- include("partials/footer.ejs") %>
</body>

</html>